        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "rtn-local-adapter",
          "name": "RTN local adapter"
        }
      }
    },
    {
      "id": "draft",
      "name": "Validate collect and journal",
      "type": "n8n-nodes-base.httpRequest",
